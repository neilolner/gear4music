{
    "name": "neilolner/gear4music-poc",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "Gear4music\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "cs": "phpcs --standard=PSR12 src tests ListInventory.php",
        "cs-fix": "phpcbf --standard=PSR12 src tests ListInventory.php",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ],
        "test": "phpunit"
    }
}
